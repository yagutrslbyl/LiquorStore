@using LiquorStore.Areas.Admin.ViewModels.Product
@{
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model CreateProductVM


<div class="container">
    <h1>Create Slider</h1>
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label for="NameInput">Name</label>
            <input asp-for="Name" type=" text" class="form-control" id="NameInput" placeholder="Enter Name">
            <span asp-validation-for="Name" class="text-danger"></span>

        </div>
        <div class="form-group">
            <label for="DescriptionInput">Description</label>
            <input asp-for="Description" type=" text" class="form-control" id="DescriptionInput"
                   placeholder="Enter Description">
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>


        <div class="form-group">
            <label for="Price">Price</label>
            <input asp-for="Price" type="number" class="form-control" id="Price"
                   placeholder="Enter Price">
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CategoryIds">Categories</label>
            <select class="form-control" id="CategoryIds">
                @foreach(var category in ViewBag.Categories)
                {
                    <option value="@category.ID">@category.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label asp-for="CategoryIds">Categories</label>
            <select class="form-control" id="CategoryIds">
                @foreach (var tag in ViewBag.Tags)
                {
                    <option value="@tag.ID">@tag.Name</option>
                }
            </select>
        </div>





        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>